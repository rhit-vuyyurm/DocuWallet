{
  "expo": {
    "name": "DocuWallet",
    "slug": "DocuWallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/docuwallet-logo.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/docuwallet-logo.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "name": "DocuWallet",
      "favicon": "./assets/docuwallet-logo.jpg",
      "output": "single"
    },
    "plugins": [
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow DocuWallet to use the camera to photograph documents.",
          "photosPermission": "Allow DocuWallet to access photos for document uploads.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5b09b723-c6d8-4211-b003-d5b9440337b3"
      }
    }
  }
}
